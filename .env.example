# ========================================
# Pragma H1 Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# The CLI reads from process.env on start
# The web console reads NEXT_PUBLIC_* variables at build time

# ========================================
# REQUIRED - Core Services
# ========================================

# Web3Auth - Authentication provider
WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here
WEB3AUTH_CLIENT_SECRET=your_web3auth_client_secret_here
# Alternative variable names (for compatibility)
# WEB3_AUTH_ID=your_web3auth_client_id_here
# WEB3_AUTH_SECRET=your_web3auth_client_secret_here

# Pimlico - Bundler/Paymaster for ERC-4337
PIMLICO_API_KEY=your_pimlico_api_key_here

# Monorail - REQUIRED for swap functionality (quotes and routing)
# Without this, swap requests will fail
MONORAIL_APP_ID=your_monorail_app_id_here

# Admin Helper - For fallback faucet/onboarding (dev/testing)
PRAGMA_ADMIN_TEST_PK=your_private_key_for_admin_helper_here

# OpenAI - Powers agent insights and educational Q&A (gpt-5-mini)
# Without this, agent will only parse swap intents (no conversational features)
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# OPTIONAL - Infrastructure Overrides
# ========================================

# Monad RPC Endpoints
MONAD_EXECUTION_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_ENVIO_READ_RPC_URL=https://monad-testnet.rpc.hypersync.xyz
MONAD_HYPERSYNC_URL=https://monad-testnet.hypersync.xyz

# Pimlico Configuration
PIMLICO_CHAIN=monad-testnet
# PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/monad-testnet/rpc?apikey=YOUR_KEY
# PIMLICO_PAYMASTER_URL=https://api.pimlico.io/v2/monad-testnet/rpc?apikey=YOUR_KEY
# PIMLICO_SPONSORSHIP_POLICY_ID=your_sponsorship_policy_id

# Monorail API Endpoints
MONORAIL_PATHFINDER_URL=https://testnet-pathfinder.monorail.xyz/v4
MONORAIL_DATA_API_URL=https://testnet-api.monorail.xyz/v1
# Note: Monorail uses App ID for auth, not API keys

# Monorail Aggregator Contract
MONORAIL_AGGREGATOR_ADDRESS=0x525B929fCd6a64AfF834f4eeCc6E860486cED700

# Envio Services
ENVIO_TOKEN_API=your_envio_bearer_token_here

# ========================================
# OPTIONAL - Token Metadata
# ========================================

MONAD_NATIVE_TOKEN_SYMBOL=MON
MONAD_NATIVE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
MONAD_WRAPPED_TOKEN_SYMBOL=WMON
MONAD_WMON_ADDRESS=0x760a3CE83eE93E3Cb0ef2dE6d9D98E27d4Ba5701

# ========================================
# OPTIONAL - Web3Auth Configuration
# ========================================

WEB3AUTH_NETWORK=sapphire_devnet
# WEB3AUTH_BRIDGE_PORT=8080

# ========================================
# OPTIONAL - Storage Directories
# ========================================

# Override default ~/.pragma locations
# PRAGMA_DELEGATION_DIR=~/.pragma/test-delegations
# PRAGMA_RECEIPT_DIR=~/.pragma/receipts

# ========================================
# OPTIONAL - Development Toggles
# ========================================

# Fixture Mode (deterministic runs, no on-chain calls)
# PRAGMA_REPL_FIXTURE=1

# Agent Debugging
# PRAGMA_AGENT_LOG=1
# PRAGMA_AGENT_DEBUG=1
# PRAGMA_AGENT_LOG_LEVEL=info

# Skip Auto-Onboarding in REPL
# PRAGMA_AGENT_SKIP_ONBOARD=1

# Start REPL with Quick Mode Enabled
# PRAGMA_AGENT_QUICK_MODE=1

# Agent Streaming
PRAGMA_AGENT_STREAM_INSIGHTS=1

# HyperSync (currently disabled - future feature)
PRAGMA_DISABLE_HYPERSYNC=1

# ========================================
# WEB CONSOLE ONLY - Client-Side Variables
# ========================================
# Mirror the above values with NEXT_PUBLIC_ prefix for browser access
# Example:
# NEXT_PUBLIC_WEB3_AUTH_ID=your_web3auth_client_id_here
# NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key_here
# NEXT_PUBLIC_MONORAIL_APP_ID=your_monorail_app_id_here
# NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
# NEXT_PUBLIC_MONAD_ENVIO_READ_RPC_URL=https://monad-testnet.rpc.hypersync.xyz
# NEXT_PUBLIC_PRAGMA_AGENT_STREAM_INSIGHTS=1
# NEXT_PUBLIC_PRAGMA_DISABLE_HYPERSYNC=1
