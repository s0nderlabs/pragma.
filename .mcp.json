{
  "mcpServers": {
    "shadcn": {
      "command": "sh",
      "args": [
        "-c",
        "cd apps/web && exec npx shadcn@latest mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}