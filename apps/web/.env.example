# ============================================================================
# Pragma Web App Environment Configuration
# ============================================================================

# REQUIREMENTS:
# - Node.js >= 20.0.0 (required by @supabase/supabase-js v2.89+)
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - NEVER use NEXT_PUBLIC_ prefix for API keys, secrets, or private keys
# - Server-only secrets are used in API routes (/app/api/**/route.ts)

# ============================================================================
# SERVER-ONLY SECRETS (NO NEXT_PUBLIC_ PREFIX)
# ============================================================================

# AI Model API Keys (used in respective proxies)
# Set NEXT_PUBLIC_MODEL_PROVIDER to: deepseek, kimi, grok, gemini, or openai
OPENAI_API_KEY=sk-proj-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
MOONSHOT_API_KEY=sk-your-moonshot-key-here
XAI_API_KEY=your-xai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Voice Transcription (Groq Whisper)
# Used in /api/voice/transcribe proxy
GROQ_API_KEY=gsk_your-groq-api-key-here

# Pimlico Bundler/Paymaster (used in /api/pimlico proxy)
PIMLICO_API_KEY=pim_your-pimlico-key-here

# Monorail/Envio API Keys (used in /api/monorail/* proxies and /api/vibetrading)
ENVIO_TOKEN_API=your-uuid-token-here
MONORAIL_API_KEY=your-bearer-token-here

# 0x DEX Aggregator (used in /api/0x/quote proxy)
ZERO_X_API_KEY=your-0x-api-key-here

# Pragma Treasury (receives affiliate fees from aggregators)
PRAGMA_TREASURY_ADDRESS=

# Pragma Contract Addresses (server-side for validation)
PRAGMA_FEE_ENFORCER_ADDRESS=
DELEGATION_MANAGER_ADDRESS=

# OKX DEX Aggregator (used in /api/okx/swap proxy)
OKX_API_KEY=your-okx-api-key-here
OKX_SECRET_KEY=your-okx-secret-key-here
# NOTE: If passphrase contains $, escape it with backslash: \$example
OKX_PASSPHRASE=your-okx-passphrase-here

# Hypersync URL for transaction queries (used in /api/vibetrading)
# Note: Hypersync may not be available on mainnet yet
MONAD_HYPERSYNC_URL=https://monad.hypersync.xyz/query

# Monad RPC with API Key (used in /api/rpc proxy or server-side operations)
# If using Ankr/Infura with embedded API key, store here (server-only)
MONAD_RPC_URL=https://rpc.ankr.com/monad_mainnet/YOUR_ANKR_KEY
MONAD_EXECUTION_RPC_URL=https://rpc.ankr.com/monad_mainnet/YOUR_ANKR_KEY

# Admin Private Key (used in /api/onboarding/deploy as fallback)
# WARNING: This is a test key only - NEVER use production keys
PRAGMA_ADMIN_TEST_PK=0xYOUR_PRIVATE_KEY_HERE

# Admin Testnet Private Key (used in /api/vibetrading for beta tester airdrops)
# WARNING: This is a testnet key only - NEVER use production keys
PRAGMA_ADMIN_TESTNET_PK=YOUR_TESTNET_PRIVATE_KEY_HERE

# Blockvision API (blockchain data provider)
BLOCKVISION_API_KEY=your-blockvision-api-key-here

# OpenSea API (NFT marketplace data)
OPENSEA_API_KEY=your-opensea-api-key-here

# Firecrawl API (web scraping for RAG)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Pinecone (vector database for RAG)
PINECONE_API_KEY=your-pinecone-api-key-here

# RAG Internal Auth Key
RAG_INTERNAL_KEY=your-internal-rag-key-here

# Redis (caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Vercel KV (key-value storage)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================================================
# PUBLIC CONFIGURATION (SAFE TO EXPOSE WITH NEXT_PUBLIC_)
# ============================================================================

# Web3Auth (Client ID is public by design, like OAuth client IDs)
NEXT_PUBLIC_WEB3_AUTH_ID=your-web3auth-client-id-here
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_mainnet

# Monad Network Configuration
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_MONAD_BLOCK_EXPLORER_URL=https://monadexplorer.com
NEXT_PUBLIC_MONAD_NATIVE_TOKEN_SYMBOL=MON
NEXT_PUBLIC_MONAD_WRAPPED_TOKEN_SYMBOL=WMON

# Public RPC Endpoints (no API keys embedded)
# Browser uses public RPC, server uses MONAD_RPC_URL with API key
# NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXECUTION_RPC_URL=https://rpc.monad.xyz
# NEXT_PUBLIC_MONAD_ENVIO_READ_RPC_URL=https://monad.rpc.hypersync.xyz

# Hypersync (Public indexer) - Note: May not be available on mainnet yet
NEXT_PUBLIC_MONAD_HYPERSYNC_URL=https://monad.hypersync.xyz

# Pimlico Configuration
NEXT_PUBLIC_PIMLICO_CHAIN=monad
# Optional: Override proxy endpoints (defaults to /api/pimlico)
# NEXT_PUBLIC_PIMLICO_BUNDLER_URL=/api/pimlico
# NEXT_PUBLIC_PIMLICO_PAYMASTER_URL=/api/pimlico
# Optional: Sponsorship policy ID (if using specific policy)
# NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=your-policy-id

# Monorail DEX Aggregator (Public endpoints)
NEXT_PUBLIC_MONORAIL_PATHFINDER_URL=https://pathfinder.monorail.xyz/v4
NEXT_PUBLIC_MONORAIL_DATA_API_URL=https://api.monorail.xyz/v2
NEXT_PUBLIC_MONORAIL_APP_ID=your-monorail-app-id
NEXT_PUBLIC_MONORAIL_AGGREGATOR_ADDRESS=0xA68A7F0601effDc65C64d9C47cA1b18D96B4352c

# Contract Addresses (Public - deployed on-chain)
NEXT_PUBLIC_MONAD_NATIVE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MONAD_WMON_ADDRESS=0x3bd359c1119da7da1d913d1c4d2b7c461115433a
NEXT_PUBLIC_APRIORI_ADDRESS=0x0c65a0bc65a5d819235b71f554d210d3f80e0852

# Feature Flags
NEXT_PUBLIC_PRAGMA_IDENTITY_PROVIDER=web3auth
NEXT_PUBLIC_PRAGMA_DISABLE_HYPERSYNC=0
NEXT_PUBLIC_PRAGMA_AGENT_STREAM_INSIGHTS=1

# AI Model Provider Selection
# Options: deepseek (default), kimi, grok, gemini, openai
NEXT_PUBLIC_MODEL_PROVIDER=deepseek

# Development/Testing (Optional)
# NEXT_PUBLIC_PRAGMA_MOCK_OWNER_ADDRESS=0x1111111111111111111111111111111111111111
# NEXT_PUBLIC_PRAGMA_MOCK_DELEGATOR_ADDRESS=0x2222222222222222222222222222222222222222

# ============================================================================
# NOTES
# ============================================================================
#
# Proxy Architecture:
# - Browser requests go to /api/* routes (Next.js API routes)
# - API routes use server-only env vars to call external services
# - This keeps API keys hidden from browser JavaScript bundles
#
# Security Best Practices:
# 1. Never commit .env files to git (use .env.example instead)
# 2. Keep .env in .gitignore
# 3. Use different keys for dev/staging/prod
# 4. Rotate keys immediately if exposed
# 5. Use CI/CD secrets manager for production
#
# Required Variables (Minimum):
# - OPENAI_API_KEY (for H2.5 agent)
# - PIMLICO_API_KEY (for bundler/paymaster)
# - NEXT_PUBLIC_WEB3_AUTH_ID (for authentication)
# - NEXT_PUBLIC_MONORAIL_APP_ID (for swap quotes)
#
# Optional (for multi-aggregator swaps):
# - ZERO_X_API_KEY (enables 0x quotes)
# - OKX_API_KEY, OKX_SECRET_KEY, OKX_PASSPHRASE (enables OKX quotes)
#

# ============================================================================
# ADMIN DASHBOARD (Optional - for internal analytics)
# ============================================================================

# Supabase (PostgreSQL database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...  # Public anon key (respects RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Service role key (bypasses RLS, server-only)

# Admin Authentication (dual: wallet signature OR password)
ADMIN_JWT_SECRET=your-secure-random-secret-key-here
ADMIN_ADDRESSES=0x06B74fe8070C96D92e3a2A8A871849Ac81e4c09e  # Comma-separated allowlist
ADMIN_PASSWORD=  # Optional password for admin access

# Admin Indexer (for external cron services like cron-job.org)
# Used to secure the /api/admin/index-payments endpoint
ADMIN_INDEX_API_KEY=your-secure-random-api-key-here
