{
  "name": "pragma",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "pragma": "./apps/cli/dist/index.js"
  },
  "scripts": {
    "dev:cli": "pnpm --filter @pragma/cli dev",
    "dev:web": "pnpm --filter web dev",
    "build:cli": "pnpm --filter @pragma/cli build",
    "pragma": "node ./apps/cli/dist/index.js",
    "dev": "pnpm -r dev",
    "build": "pnpm run build:ts && pnpm -r build",
    "build:ts": "tsc -b tsconfig.json",
    "clean": "pnpm run clean:ts && pnpm -r --if-present clean",
    "clean:ts": "tsc -b tsconfig.json --clean",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "pnpm run build:cli",
    "repl:fixtures": "node scripts/repl-fixtures.mjs",
    "test:repl-e2e": "node scripts/repl-smoke.mjs",
    "build:cli-and-core": "pnpm --filter @pragma/core build && pnpm --filter @pragma/utils build && pnpm --filter @pragma/cli build"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.42",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.7.0",
    "@openai/agents": "^0.1.9",
    "@pinecone-database/pinecone": "^6.1.3"
  }
}
